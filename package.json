{
  "$schema": "https://json.schemastore.org/package",
  "name": "verdaccio-openid",
  "version": "0.19.0",
  "description": "A UI for OIDC authentication for Verdaccio, a fork of verdaccio-github-oauth-ui",
  "keywords": [
    "authentication",
    "oauth",
    "oauth2",
    "oidc",
    "openid",
    "ui",
    "verdaccio"
  ],
  "homepage": "https://github.com/kuoruan/verdaccio-openid#readme",
  "bugs": {
    "url": "https://github.com/kuoruan/verdaccio-openid/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Xingwang Liao",
    "email": "kuoruan@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuoruan/verdaccio-openid.git"
  },
  "bin": "./dist/verdaccio-openid.mjs",
  "files": [
    "dist"
  ],
  "main": "./dist/server/index.js",
  "module": "./dist/server/index.mjs",
  "scripts": {
    "build": "cross-env NODE_ENV=production tsdown",
    "changeset": "changeset",
    "start": "cross-env DEBUG='verdaccio:*' node_modules/verdaccio/bin/verdaccio -c verdaccio/verdaccio.yml",
    "start:5": "cross-env DEBUG='verdaccio:*' node_modules/verdaccio5/bin/verdaccio -c verdaccio5/verdaccio.yml",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest --run",
    "release": "changeset publish",
    "version": "node scripts/version.mjs",
    "prepublishOnly": "pnpm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@gitbeaker/rest": "^43.8.0",
    "@isaacs/ttlcache": "^2.1.5",
    "@verdaccio/auth": "^8.1.3",
    "@verdaccio/config": "^8.3.0",
    "@verdaccio/core": "^8.3.0",
    "@verdaccio/url": "^13.1.3",
    "debug": "^4.4.3",
    "deepmerge": "^4.3.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "global-agent": "^4.1.3",
    "minimist": "^1.2.8",
    "ms": "^2.1.3",
    "open": "^11.0.3",
    "openid-client": "^6.8.8",
    "picocolors": "^1.1.1",
    "serve-static": "^2.2.1",
    "stable-hash": "^0.0.6",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@tsconfig/node20": "^20.1.10",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/global-agent": "^3.0.0",
    "@types/lodash": "^4.17.25",
    "@types/minimist": "^1.2.5",
    "@types/ms": "^2.1.0",
    "@types/node": "^20.19.43",
    "@types/node-persist": "^3.1.8",
    "@types/serve-static": "^2.2.0",
    "@verdaccio/types": "^13.0.6",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "mongodb": "^7.6.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "verdaccio": "^6.10.3",
    "verdaccio-htpasswd": "^13.1.3",
    "verdaccio-openid": "link:",
    "verdaccio5": "npm:verdaccio@5.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "ioredis": "^5.11.1",
    "mongodb": "^6.0.0||^7.0.0",
    "node-persist": "^4.0.4",
    "verdaccio": "^5.0.0||^6.0.0||^7.0.0-next-0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/lib-dynamodb": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "node-persist": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.27.0"
}
